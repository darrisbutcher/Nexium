accessWidener v2 official

# The Crafting Terminal reuses vanilla's recipe-book screen, which fixes the screen size at 176x166.
mutable field net/minecraft/client/gui/screens/inventory/AbstractContainerScreen imageWidth I
mutable field net/minecraft/client/gui/screens/inventory/AbstractContainerScreen imageHeight I

# The Codex lookup key opens the page of the item under the mouse in any inventory.
accessible field net/minecraft/client/gui/screens/inventory/AbstractContainerScreen hoveredSlot Lnet/minecraft/world/inventory/Slot;

# The Crafting Terminal's search and the recipe book's search stay the same.
accessible field net/minecraft/client/gui/screens/recipebook/RecipeBookComponent searchBox Lnet/minecraft/client/gui/components/EditBox;

# The sort key finds the area under the mouse from the screen's corner.
accessible field net/minecraft/client/gui/screens/inventory/AbstractContainerScreen leftPos I
accessible field net/minecraft/client/gui/screens/inventory/AbstractContainerScreen topPos I
