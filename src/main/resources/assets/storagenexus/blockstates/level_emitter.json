{
  "multipart": [
    {
      "when": {
        "powered": "false"
      },
      "apply": {
        "model": "storagenexus:block/level_emitter_core_off"
      }
    },
    {
      "when": {
        "powered": "true"
      },
      "apply": {
        "model": "storagenexus:block/level_emitter_core_on"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "storagenexus:block/level_emitter_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "storagenexus:block/level_emitter_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "storagenexus:block/level_emitter_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "storagenexus:block/level_emitter_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "storagenexus:block/level_emitter_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "storagenexus:block/level_emitter_arm",
        "x": 90
      }
    }
  ]
}