{
  "multipart": [
    {
      "apply": {
        "model": "storagenexus:block/conduit_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "storagenexus:block/conduit_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "storagenexus:block/conduit_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "storagenexus:block/conduit_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "storagenexus:block/conduit_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "storagenexus:block/conduit_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "storagenexus:block/conduit_arm",
        "x": 90
      }
