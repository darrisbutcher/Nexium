      },
      "apply": {
        "model": "storagenexus:block/conduit_band_fluid"
      }
    },
    {
      "when": {
        "fluid_tier": "2"
      },
      "apply": {
        "model": "storagenexus:block/conduit_trim_fluid_tier2"
      }
    },
    {
      "when": {
        "fluid_tier": "3"
      },
      "apply": {
        "model": "storagenexus:block/conduit_trim_fluid_top"
      }
    }
