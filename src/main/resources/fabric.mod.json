{
  "schemaVersion": 1,
  "id": "storagenexus",
  "version": "${version}",
  "name": "Storage Nexus",
  "description": "Drawers, a simple storage network, cross-dimensional tablets and links, and Ender IO-style item and fluid conduits.",
  "authors": [
    "Darris"
  ],
  "license": "MIT",
  "icon": "assets/storagenexus/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.storagenexus.StorageNexus"
    ],
    "client": [
      "net.storagenexus.client.StorageNexusClient"
    ],
    "jei_mod_plugin": [
      "net.storagenexus.compat.jei.StorageNexusJeiPlugin"
    ],
    "rei_client": [
      "net.storagenexus.compat.rei.StorageNexusReiPlugin"
    ]
  },
  "accessWidener": "storagenexus.accesswidener",
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*",
    "roughlyenoughitems": "*"
  }
}
